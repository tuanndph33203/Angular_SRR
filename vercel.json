{
  "version": 2,
  "buildCommand": "npm run build:ssr",
  "outputDirectory": "dist/got-prerender-demo/browser",
  "builds": [
    {
      "src": "dist/got-prerender-demo/server/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/got-prerender-demo/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/got-prerender-demo/server/main.js"
    }
  ]
}
